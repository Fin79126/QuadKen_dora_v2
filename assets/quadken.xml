<mujoco model="quadken_auv">
  <!--
    QuadKen AUV (Autonomous Underwater Vehicle)
    Specifications:
      - Main Cylindrical Hull: Diameter 0.24m (radius 0.12m), Length 0.70m, Weight ~8.0kg
      - 4 Legs: Length 0.30m, Opening angle 0-90 degrees (Inner to Outer deployment)
      - Direct Degree Control: Actuators operate directly on 0 to 90 degrees!
      - 4 Inter-leg Deformable Membranes (Skins) connecting adjacent legs like an umbrella/webbing
      - Dual BLDC Thrusters: Diameter 0.04m, tandem in-line inside the 4 legs, counter-rotating to cancel torque
      - Head Ballast System: 4 water-intake servos at the front dome
      - Net Positive Buoyancy: Slight positive buoyancy (~+0.3kgf) with nose-up pitch trim
      - Full 3D Roll / Pitch / Yaw rotation
  -->

  <compiler angle="degree" coordinate="local" inertiafromgeom="auto"/>

  <option density="1000" viscosity="0.001" gravity="0 0 -9.81" integrator="implicitfast" timestep="0.005">
    <flag contact="enable" energy="enable"/>
  </option>

  <visual>
    <global offwidth="1920" offheight="1080"/>
    <quality shadowsize="2048"/>
  </visual>

  <default>
    <joint damping="0.8" armature="0.01"/>
    <geom condim="3" friction="0.8 0.1 0.1"/>
    <!-- Default for Leg joints: Opens 0 to 90 deg from inner to outer -->
    <default class="leg_joint">
      <joint type="hinge" limited="true" range="0 90" damping="1.5" stiffness="0.1"/>
    </default>
    <!-- Default for Servo Actuators: Direct 0 to 90 Degree control -->
    <!-- Gain 0.5 N*m/deg, bias scales rad to deg seamlessly -->
    <default class="servo_actuator">
      <general dyntype="none" biastype="affine" gainprm="0.5 0 0" biasprm="0 -28.64789 -0.05"
               ctrlrange="0 90" forcelimited="true" forcerange="-25 25"/>
    </default>
  </default>

  <asset>
    <!-- Underwater environment visuals -->
    <texture type="skybox" builtin="gradient" rgb1="0.05 0.2 0.35" rgb2="0.01 0.05 0.12" width="512" height="512"/>
    <texture name="seafloor_tex" type="2d" builtin="checker" rgb1="0.25 0.28 0.22" rgb2="0.18 0.20 0.16" width="256" height="256"/>
    <material name="seafloor_mat" texture="seafloor_tex" texrepeat="20 20" reflectance="0.05"/>

    <!-- Robot materials -->
    <material name="hull_mat" rgba="0.75 0.80 0.85 1.0" shininess="0.8" specular="0.6"/>
    <material name="frame_mat" rgba="0.25 0.28 0.32 1.0" shininess="0.5"/>
    <material name="intake_mat" rgba="0.15 0.18 0.20 1.0"/>
    <material name="leg_mat" rgba="0.30 0.35 0.40 1.0" shininess="0.6"/>
    <material name="thruster_mat" rgba="0.1 0.1 0.1 1.0" shininess="0.9"/>
    <material name="propeller_cw" rgba="0.1 0.6 0.8 0.9"/>
    <material name="propeller_ccw" rgba="0.8 0.4 0.1 0.9"/>
    <!-- Translucent flexible inter-leg membrane -->
    <material name="membrane_mat" rgba="0.80 0.92 1.0 0.55" shininess="0.9" specular="0.8"/>
    <!-- Underwater targets and landmarks -->
    <material name="gate_mat" rgba="0.95 0.75 0.1 1.0" shininess="0.7"/>
    <material name="buoy_red" rgba="0.9 0.15 0.15 1.0" shininess="0.8"/>
    <material name="buoy_green" rgba="0.15 0.85 0.25 1.0" shininess="0.8"/>
    <material name="pillar_mat" rgba="0.4 0.45 0.5 1.0"/>
  </asset>

  <worldbody>
    <light directional="true" pos="0 0 8" dir="0 0 -1" diffuse="0.8 0.85 0.9" specular="0.3 0.3 0.3"/>
    <light directional="false" pos="2 2 3" diffuse="0.3 0.5 0.6"/>

    <!-- Seafloor at 5m depth -->
    <geom name="seafloor" type="plane" pos="0 0 -5.0" size="30 30 0.1" material="seafloor_mat"/>

    <!-- Underwater Navigation Gate 1 (at X=3m, submerged at Z=-1.5m) -->
    <body name="gate_1" pos="3.0 0 -1.5">
      <geom name="gate_1_left" type="cylinder" fromto="0 -0.8 -0.8  0 -0.8 0.8" size="0.04" material="gate_mat"/>
      <geom name="gate_1_right" type="cylinder" fromto="0 0.8 -0.8   0 0.8 0.8" size="0.04" material="gate_mat"/>
      <geom name="gate_1_top" type="cylinder" fromto="0 -0.8 0.8   0 0.8 0.8" size="0.04" material="gate_mat"/>
    </body>

    <!-- Underwater Navigation Gate 2 (at X=6.5m, submerged at Z=-1.8m) -->
    <body name="gate_2" pos="6.5 0.5 -1.8">
      <geom name="gate_2_left" type="cylinder" fromto="0 -0.8 -0.8  0 -0.8 0.8" size="0.04" material="gate_mat"/>
      <geom name="gate_2_right" type="cylinder" fromto="0 0.8 -0.8   0 0.8 0.8" size="0.04" material="gate_mat"/>
      <geom name="gate_2_top" type="cylinder" fromto="0 -0.8 0.8   0 0.8 0.8" size="0.04" material="gate_mat"/>
    </body>

    <!-- Navigation Buoys / Markers -->
    <geom name="marker_buoy_1" type="sphere" pos="2.0 1.2 -1.5" size="0.15" material="buoy_red"/>
    <geom name="marker_buoy_2" type="sphere" pos="4.5 -1.2 -1.6" size="0.15" material="buoy_green"/>
    <geom name="marker_buoy_3" type="sphere" pos="8.0 0.0 -1.5" size="0.20" material="buoy_red"/>

    <!-- Seafloor Coral / Rock Pillars -->
    <geom name="rock_1" type="cylinder" fromto="1.5 2.0 -5.0  1.5 2.0 -2.5" size="0.3" material="pillar_mat"/>
    <geom name="rock_2" type="cylinder" fromto="5.0 -2.5 -5.0  5.0 -2.5 -2.0" size="0.4" material="pillar_mat"/>
    <geom name="rock_3" type="cylinder" fromto="8.5 2.0 -5.0  8.5 2.0 -2.2" size="0.35" material="pillar_mat"/>

    <!-- ============================================================ -->
    <!-- QUADKEN AUV ROBOT ROOT                                      -->
    <!-- Submerged at Z = -1.5m, free 6-DOF (Roll / Pitch / Yaw)     -->
    <!-- ============================================================ -->
    <body name="auv" pos="0 0 -1.5">
      <!-- 6-DOF Free movement in water -->
      <freejoint name="root"/>

      <!--
        Mass & Inertia Balance:
        Total weight: 8.0 kg (Gravity = 78.48 N)
        Target Buoyancy: ~8.3 kgf = 81.42 N (Net +2.94 N upward)
        Center of Gravity (CoG): Positioned towards aft/lower (X=0.28, Z=-0.02)
        Center of Buoyancy (CoB): Positioned towards nose/upper (X=0.42, Z=+0.02)
        -> Naturally produces nose-up static pitch trim!
      -->
      <inertial pos="0.28 0 -0.02" mass="6.8" diaginertia="0.12 0.32 0.32"/>

      <!-- ========================================== -->
      <!-- 1. MAIN CYLINDRICAL BODY (Diameter 24cm, Length 70cm) -->
      <!-- From X=0.00 (Aft rim) to X=0.70 (Nose base) -->
      <!-- ========================================== -->
      <geom name="hull_cylinder" type="cylinder" fromto="0 0 0  0.70 0 0" size="0.12" material="hull_mat" density="250"/>
      <!-- Nose Dome (Front Hemisphere, R=0.12m at X=0.70) -->
      <geom name="nose_dome" type="sphere" pos="0.70 0 0" size="0.12" material="hull_mat" density="200"/>
      <!-- Aft Endcap Rim -->
      <geom name="aft_rim" type="cylinder" fromto="-0.01 0 0  0.01 0 0" size="0.122" material="frame_mat" mass="0.4"/>

      <!-- Head Water-Intake Ports (4 Slits at Nose for ESP2 Ballast) -->
      <geom name="intake_top" type="box" pos="0.74 0 0.08" size="0.02 0.03 0.008" material="intake_mat" mass="0.01"/>
      <geom name="intake_right" type="box" pos="0.74 -0.08 0" size="0.02 0.008 0.03" material="intake_mat" mass="0.01"/>
      <geom name="intake_bottom" type="box" pos="0.74 0 -0.08" size="0.02 0.03 0.008" material="intake_mat" mass="0.01"/>
      <geom name="intake_left" type="box" pos="0.74 0.08 0" size="0.02 0.008 0.03" material="intake_mat" mass="0.01"/>

      <!-- Internal Buoyancy Foam Block (Center of Buoyancy bias towards nose-up) -->
      <geom name="buoyancy_pod" type="capsule" fromto="0.32 0 0.02  0.62 0 0.02" size="0.08" rgba="0.1 0.8 0.2 0.0" mass="0.1"/>

      <!-- Sensors Site inside Hull -->
      <site name="imu_site" pos="0.35 0 0" size="0.02" rgba="1 0 0 1"/>
      <site name="depth_sensor_site" pos="0.68 0 -0.08" size="0.01" rgba="0 1 1 1"/>

      <!-- Underwater Cameras -->
      <geom name="camera_lens" type="sphere" pos="0.81 0 0" size="0.03" rgba="0.1 0.1 0.2 0.8" mass="0.01"/>
      <camera name="front_camera" pos="0.82 0 0" xyaxes="0 -1 0 0 0 1" fovy="75"/>
      <!-- Third-person Overhead Chase Camera (View from aft-top looking down-forward at body & legs) -->
      <camera name="overhead_camera" pos="-1.1 0 0.55" xyaxes="0 -1 0 0.382 0 0.924" fovy="65"/>
      <!-- Direct Top-Down Bird's-Eye Camera -->
      <camera name="topdown_camera" pos="0.35 0 1.6" xyaxes="0 -1 0 1 0 0" fovy="65"/>

      <!-- ========================================== -->
      <!-- 2. BLDC THRUSTERS (Dual Tandem, Inside 4 Legs) -->
      <!-- Diameter 4cm (radius 0.02m), in-line along central axis -->
      <!-- ========================================== -->
      <!-- Forward Thruster 1 (Front/CW) -->
      <geom name="thruster_shroud_1" type="cylinder" fromto="-0.03 0 0  -0.08 0 0" size="0.02" material="thruster_mat" mass="0.15"/>
      <geom name="propeller_1" type="cylinder" fromto="-0.05 0 0  -0.06 0 0" size="0.019" material="propeller_cw" mass="0.03"/>
      <site name="thrust_site_1" pos="-0.05 0 0" size="0.015" rgba="0 1 0 1"/>

      <!-- Forward Thruster 2 (Aft/CCW, Counter-Rotating to cancel torque) -->
      <geom name="thruster_shroud_2" type="cylinder" fromto="-0.12 0 0  -0.17 0 0" size="0.02" material="thruster_mat" mass="0.15"/>
      <geom name="propeller_2" type="cylinder" fromto="-0.14 0 0  -0.15 0 0" size="0.019" material="propeller_ccw" mass="0.03"/>
      <site name="thrust_site_2" pos="-0.14 0 0" size="0.015" rgba="1 0.5 0 1"/>

      <!-- Central Support Stator Rod holding thrusters to aft rim -->
      <geom name="thruster_shaft" type="cylinder" fromto="0 0 0  -0.20 0 0" size="0.008" material="frame_mat" mass="0.1"/>

      <!-- ========================================== -->
      <!-- 3. FOUR CLEAN STRUT LEGS (ESP1)            -->
      <!-- Mounted on Aft Rim (X=0, R=0.12m), Length 30cm -->
      <!-- Hinges open radially from INNER to OUTER (0 to 90 deg) -->
      <!-- ========================================== -->

      <!-- LEG 0: TOP (pos: 0, 0, +0.12m) -->
      <!-- axis="0 1 0" rotates from -X towards +Z (Opens outward/upward) -->
      <body name="leg_top" pos="0 0 0.12">
        <joint name="joint_leg_top" class="leg_joint" pos="0 0 0" axis="0 1 0"/>
        <geom name="strut_top" type="capsule" fromto="0 0 0  -0.30 0 0" size="0.012" material="leg_mat" mass="0.14"/>
        <geom name="tip_top" type="sphere" pos="-0.30 0 0" size="0.014" material="frame_mat" mass="0.02"/>
      </body>

      <!-- LEG 1: RIGHT (pos: 0, -0.12m, 0) -->
      <!-- axis="0 0 1" rotates from -X towards -Y (Opens outward/rightward) -->
      <body name="leg_right" pos="0 -0.12 0">
        <joint name="joint_leg_right" class="leg_joint" pos="0 0 0" axis="0 0 1"/>
        <geom name="strut_right" type="capsule" fromto="0 0 0  -0.30 0 0" size="0.012" material="leg_mat" mass="0.14"/>
        <geom name="tip_right" type="sphere" pos="-0.30 0 0" size="0.014" material="frame_mat" mass="0.02"/>
      </body>

      <!-- LEG 2: BOTTOM (pos: 0, 0, -0.12m) -->
      <!-- axis="0 -1 0" rotates from -X towards -Z (Opens outward/downward) -->
      <body name="leg_bottom" pos="0 0 -0.12">
        <joint name="joint_leg_bottom" class="leg_joint" pos="0 0 0" axis="0 -1 0"/>
        <geom name="strut_bottom" type="capsule" fromto="0 0 0  -0.30 0 0" size="0.012" material="leg_mat" mass="0.14"/>
        <geom name="tip_bottom" type="sphere" pos="-0.30 0 0" size="0.014" material="frame_mat" mass="0.02"/>
      </body>

      <!-- LEG 3: LEFT (pos: 0, +0.12m, 0) -->
      <!-- axis="0 0 -1" rotates from -X towards +Y (Opens outward/leftward) -->
      <body name="leg_left" pos="0 0.12 0">
        <joint name="joint_leg_left" class="leg_joint" pos="0 0 0" axis="0 0 -1"/>
        <geom name="strut_left" type="capsule" fromto="0 0 0  -0.30 0 0" size="0.012" material="leg_mat" mass="0.14"/>
        <geom name="tip_left" type="sphere" pos="-0.30 0 0" size="0.014" material="frame_mat" mass="0.02"/>
      </body>

      <!-- ========================================== -->
      <!-- 4. HEAD BALLAST WATER-INTAKE SERVOS (ESP2) -->
      <!-- 4 rotational valve cylinders at nose       -->
      <!-- ========================================== -->
      <body name="ballast_valve_1" pos="0.65 0 0.07">
        <joint name="joint_ballast_1" class="leg_joint" axis="0 1 0"/>
        <geom name="geom_ballast_1" type="cylinder" fromto="0 -0.015 0  0 0.015 0" size="0.015" material="intake_mat" mass="0.03"/>
      </body>
      <body name="ballast_valve_2" pos="0.65 -0.07 0">
        <joint name="joint_ballast_2" class="leg_joint" axis="0 0 1"/>
        <geom name="geom_ballast_2" type="cylinder" fromto="0 0 -0.015  0 0 0.015" size="0.015" material="intake_mat" mass="0.03"/>
      </body>
      <body name="ballast_valve_3" pos="0.65 0 -0.07">
        <joint name="joint_ballast_3" class="leg_joint" axis="0 -1 0"/>
        <geom name="geom_ballast_3" type="cylinder" fromto="0 -0.015 0  0 0.015 0" size="0.015" material="intake_mat" mass="0.03"/>
      </body>
      <body name="ballast_valve_4" pos="0.65 0.07 0">
        <joint name="joint_ballast_4" class="leg_joint" axis="0 0 -1"/>
        <geom name="geom_ballast_4" type="cylinder" fromto="0 0 -0.015  0 0 0.015" size="0.015" material="intake_mat" mass="0.03"/>
      </body>

    </body>
  </worldbody>

  <!-- ============================================================ -->
  <!-- DEFORMABLE SKINS: MEMBRANES CONNECTING ADJACENT LEGS        -->
  <!-- 4 translucent skins stretch between neighboring legs like an umbrella -->
  <!-- ============================================================ -->
  <deformable>
    <!-- 1. Membrane between Leg TOP and Leg RIGHT -->
    <!-- Vertices: [0: Top Root, 1: Top Tip, 2: Right Tip, 3: Right Root] -->
    <skin name="membrane_top_right"
          vertex="0 0 0.12   -0.30 0 0.12   -0.30 -0.12 0   0 -0.12 0"
          face="0 1 2   0 2 3"
          material="membrane_mat">
      <bone body="leg_top"   bindpos="0 0 0.12"  bindquat="1 0 0 0" vertid="0 1" vertweight="1.0 1.0"/>
      <bone body="leg_right" bindpos="0 -0.12 0" bindquat="1 0 0 0" vertid="3 2" vertweight="1.0 1.0"/>
    </skin>

    <!-- 2. Membrane between Leg RIGHT and Leg BOTTOM -->
    <!-- Vertices: [0: Right Root, 1: Right Tip, 2: Bottom Tip, 3: Bottom Root] -->
    <skin name="membrane_right_bottom"
          vertex="0 -0.12 0   -0.30 -0.12 0   -0.30 0 -0.12   0 0 -0.12"
          face="0 1 2   0 2 3"
          material="membrane_mat">
      <bone body="leg_right"  bindpos="0 -0.12 0" bindquat="1 0 0 0" vertid="0 1" vertweight="1.0 1.0"/>
      <bone body="leg_bottom" bindpos="0 0 -0.12" bindquat="1 0 0 0" vertid="3 2" vertweight="1.0 1.0"/>
    </skin>

    <!-- 3. Membrane between Leg BOTTOM and Leg LEFT -->
    <!-- Vertices: [0: Bottom Root, 1: Bottom Tip, 2: Left Tip, 3: Left Root] -->
    <skin name="membrane_bottom_left"
          vertex="0 0 -0.12   -0.30 0 -0.12   -0.30 0.12 0   0 0.12 0"
          face="0 1 2   0 2 3"
          material="membrane_mat">
      <bone body="leg_bottom" bindpos="0 0 -0.12" bindquat="1 0 0 0" vertid="0 1" vertweight="1.0 1.0"/>
      <bone body="leg_left"   bindpos="0 0.12 0"  bindquat="1 0 0 0" vertid="3 2" vertweight="1.0 1.0"/>
    </skin>

    <!-- 4. Membrane between Leg LEFT and Leg TOP -->
    <!-- Vertices: [0: Left Root, 1: Left Tip, 2: Top Tip, 3: Top Root] -->
    <skin name="membrane_left_top"
          vertex="0 0.12 0   -0.30 0.12 0   -0.30 0 0.12   0 0 0.12"
          face="0 1 2   0 2 3"
          material="membrane_mat">
      <bone body="leg_left" bindpos="0 0.12 0" bindquat="1 0 0 0" vertid="0 1" vertweight="1.0 1.0"/>
      <bone body="leg_top"  bindpos="0 0 0.12" bindquat="1 0 0 0" vertid="3 2" vertweight="1.0 1.0"/>
    </skin>
  </deformable>

  <!-- ============================================================ -->
  <!-- ACTUATORS DEFINITION                                         -->
  <!-- Matching QuadKen Dora Architecture (ESP1 + ESP2)             -->
  <!-- Control inputs are directly in DEGREES [0 to 90]!            -->
  <!-- ============================================================ -->
  <actuator>
    <!-- ===== ESP1: THRUST & DRAG-STEERING UNIT ===== -->
    <!-- 2x Forward BLDC Thrusters (Tandem In-Line, Counter-Rotating) -->
    <motor name="bldc_thruster_1" site="thrust_site_1" gear="1.0 0 0  0.02 0 0" ctrllimited="true" ctrlrange="0 200"/>
    <motor name="bldc_thruster_2" site="thrust_site_2" gear="1.0 0 0 -0.02 0 0" ctrllimited="true" ctrlrange="0 200"/>

    <!-- 4x Membrane Leg Deployment Servos (Direct 0 to 90 degrees!) -->
    <general name="leg_servo_top" joint="joint_leg_top" class="servo_actuator"/>
    <general name="leg_servo_right" joint="joint_leg_right" class="servo_actuator"/>
    <general name="leg_servo_bottom" joint="joint_leg_bottom" class="servo_actuator"/>
    <general name="leg_servo_left" joint="joint_leg_left" class="servo_actuator"/>

    <!-- ===== ESP2: HEAD BALLAST BUOYANCY UNIT ===== -->
    <!-- 4x Head Water-Intake Ballast Servos (Direct 0 to 90 degrees!) -->
    <general name="ballast_servo_1" joint="joint_ballast_1" class="servo_actuator"/>
    <general name="ballast_servo_2" joint="joint_ballast_2" class="servo_actuator"/>
    <general name="ballast_servo_3" joint="joint_ballast_3" class="servo_actuator"/>
    <general name="ballast_servo_4" joint="joint_ballast_4" class="servo_actuator"/>
  </actuator>

  <!-- ============================================================ -->
  <!-- SENSORS DEFINITION                                           -->
  <!-- ============================================================ -->
  <sensor>
    <!-- Orientation Quaternion from IMU (Supports 3D Roll / Pitch / Yaw) -->
    <framequat name="imu_quat" objtype="site" objname="imu_site"/>
    <!-- Angular Velocity (Gyro) -->
    <gyro name="imu_gyro" site="imu_site"/>
    <!-- Linear Acceleration (Accelerometer) -->
    <accelerometer name="imu_accel" site="imu_site"/>
  </sensor>
</mujoco>
